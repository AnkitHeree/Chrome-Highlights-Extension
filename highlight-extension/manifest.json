{
  "manifest_version": 3,
  "name": "Page Highlighter",
  "version": "1.3.0",
  "description": "Save and restore text highlights on any webpage. Highlights persist across reloads using character-offset anchoring. Supports export/import, dynamic pages, and keyboard shortcuts.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Page Highlighter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "highlight-yellow": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Highlight selection in yellow"
    },
    "highlight-green": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Highlight selection in green"
    },
    "highlight-blue": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Highlight selection in blue"
    },
    "remove-highlights": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Remove highlights under selection / cursor"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/highlight.css"],
      "run_at": "document_idle"
    }
  ]
}
